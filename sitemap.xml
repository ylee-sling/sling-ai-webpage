---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | where_exp: "p", "p.sitemap != false" | sort: "url" %}
{%- for p in pages %}
  {%- if p.url contains ".css" or p.url contains ".xml" or p.url contains ".txt" %}{% continue %}{% endif %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
</urlset>
